  "description": "Event-Driven Financial Transaction & Fraud Detection Engine",
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/app.js",
    "consumer:ledger": "tsx src/consumers/ledger.consumer.ts",
    "consumer:projection": "tsx src/consumers/projection.consumer.ts",
    "consumer:fraud": "tsx src/consumers/fraud.consumer.ts",
    "consumer:webhook": "tsx src/consumers/webhook.consumer.ts",
    "worker:dlq": "tsx src/workers/dlq.worker.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "cron:reconciliation": "tsx src/workers/reconciliation.cron.ts",
    "cron:payout": "tsx src/modules/payout/payout.scheduler.ts",
    "worker:compensation": "tsx src/workers/compensation.worker.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
