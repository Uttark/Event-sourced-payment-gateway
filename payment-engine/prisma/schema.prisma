generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum Currency {
  USD
  INR
  EUR
  GBP
}

enum TransactionEventType {
  INITIALIZED
  GATEWAY_CHARGE_SUCCEEDED
  GATEWAY_CHARGE_FAILED
  PAYMENT_COMPLETED
  PAYMENT_FAILED

  DEPOSIT_INITIATED
  DEPOSIT_COMPLETED

  TRANSFER_DEBIT
  TRANSFER_CREDIT

  FRAUD_FLAGGED
  FRAUD_CLEARED

  REFUND_INITIATED
  REFUND_COMPLETED
  REFUND_FAILED

  PAYOUT_INITIATED
  PAYOUT_COMPLETED
  PAYOUT_FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD_LETTERED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  wallets   Wallet[]
  merchants Merchant[]

  @@map("users")
}

model Wallet {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  currency  Currency
  balance   Decimal      @default(0) @db.Decimal(20, 8)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, currency])
  @@index([userId])
  @@map("wallets")
}

model TransactionEvent {
  id               String               @id @default(uuid())

  eventId          String               @unique @default(uuid()) @map("event_id")

  transactionId    String               @map("transaction_id")

  walletId         String               @map("wallet_id")
  userId           String               @map("user_id")
  eventType        TransactionEventType @map("event_type")

  amount           Decimal              @db.Decimal(20, 8)
  currency         Currency

  gatewayOrderId   String?              @map("gateway_order_id")
  gatewayPaymentId String?              @map("gateway_payment_id")

  idempotencyKey   String?              @map("idempotency_key")

  fraudScore       Float?               @map("fraud_score")

  metadata         Json                 @default("{}")

  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([gatewayOrderId])
  @@map("transaction_events")
}

model WalletProjection {
  id               String    @id @default(uuid())
  walletId         String    @unique @map("wallet_id")
  userId           String    @map("user_id")
  currency         Currency

  balance          Decimal   @default(0) @db.Decimal(20, 8)

  totalCredited    Decimal   @default(0) @db.Decimal(20, 8) @map("total_credited")
  totalDebited     Decimal   @default(0) @db.Decimal(20, 8) @map("total_debited")
  transactionCount Int       @default(0) @map("transaction_count")

  lastEventId      String?   @map("last_event_id")
  lastTransactionAt DateTime? @map("last_transaction_at")

  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("wallet_projections")
}

model ProcessedEvent {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")

  consumerGroup String   @map("consumer_group")

  processedAt   DateTime @default(now()) @map("processed_at")

  @@unique([eventId, consumerGroup])
  @@index([eventId])
  @@map("processed_events")
}

model Merchant {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  businessName   String   @map("business_name")

  webhookSecret  String   @map("webhook_secret")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id])
  webhookEndpoints WebhookEndpoint[]
  payouts          Payout[]

  @@index([userId])
  @@map("merchants")
}

model WebhookEndpoint {
  id         String    @id @default(uuid())
  merchantId String    @map("merchant_id")
  url        String
  isActive   Boolean   @default(true) @map("is_active")

  eventTypes String[]  @map("event_types")

  createdAt  DateTime  @default(now()) @map("created_at")

  merchant          Merchant          @relation(fields: [merchantId], references: [id])
  webhookDeliveries WebhookDelivery[]

  @@index([merchantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                  String                @id @default(uuid())
  webhookEndpointId   String                @map("webhook_endpoint_id")

  transactionEventId  String                @map("transaction_event_id")

  payload             Json

  status              WebhookDeliveryStatus @default(PENDING)
  attemptCount        Int                   @default(0) @map("attempt_count")
  lastAttemptAt       DateTime?             @map("last_attempt_at")
  lastHttpStatusCode  Int?                  @map("last_http_status_code")
  lastResponseBody    String?               @map("last_response_body") @db.Text

  nextRetryAt         DateTime?             @map("next_retry_at")

  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id])

  @@index([transactionEventId])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model DeadLetterWebhook {
  id                  String    @id @default(uuid())
  webhookDeliveryId   String    @unique @map("webhook_delivery_id")
  webhookEndpointId   String    @map("webhook_endpoint_id")
  transactionEventId  String    @map("transaction_event_id")
  payload             Json

  failureReason       String    @map("failure_reason") @db.Text
  attemptCount        Int       @map("attempt_count")

  createdAt           DateTime  @default(now()) @map("created_at")

  resolvedAt          DateTime? @map("resolved_at")
  resolvedBy          String?   @map("resolved_by")

  @@index([webhookEndpointId])
  @@index([createdAt])
  @@map("dead_letter_webhooks")
}

model ReconciliationLog {
  id             String   @id @default(uuid())
  transactionId  String   @map("transaction_id")
  gatewayOrderId String   @map("gateway_order_id")

  gatewayStatus  String   @map("gateway_status")

  actionTaken    String   @map("action_taken")

  runAt          DateTime @default(now()) @map("run_at")

  @@index([transactionId])
  @@index([runAt])
  @@map("reconciliation_logs")
}

model Payout {
  id              String       @id @default(uuid())
  merchantId      String       @map("merchant_id")
  amount          Decimal      @db.Decimal(20, 8)
  currency        Currency
  status          PayoutStatus @default(PENDING)
  scheduledAt     DateTime     @map("scheduled_at")
  processedAt     DateTime?    @map("processed_at")

  gatewayPayoutId String?      @map("gateway_payout_id")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, status])
  @@index([scheduledAt, status])
  @@map("payouts")
}